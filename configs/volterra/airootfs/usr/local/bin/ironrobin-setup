#!/usr/bin/env bash

echo "Checking for internet connection"
if ! ping -c 1 archlinux.org; then
    echo "No internet connection detected. Please connect to the internet and try again."
    exit 1
fi

echo "Checking for ironrobin-volterra repository in pacman"
if grep -q "\[ironrobin-volterra\]" /etc/pacman.conf; then
    echo "ironrobin-volterra repository already in pacman"
else
    echo "Adding ironrobin-volterra repository to pacman"
    echo -e "\n[ironrobin-volterra]\nServer = https://github.com/ironrobin/volterra-alarm/releases/download/packages\n" >> /etc/pacman.conf
fi

echo "Checking for ironrobin-volterra gpg keys in pacman"
if pacman-key --list-keys 6ED02751500A833A; then
    echo "ironrobin-volterra gpg keys already in pacman"
else
    echo "Adding ironrobin-volterra gpg keys to pacman"
    pacman-key --recv-keys 6ED02751500A833A
    pacman-key --lsign-key 6ED02751500A833A
fi

echo "Updating pacman database"
pacman -Sy
